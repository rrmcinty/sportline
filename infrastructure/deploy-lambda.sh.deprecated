#!/usr/bin/env bash
#
# Deploy Lambda functions for Sportline dashboard
# Creates Lambda functions, sets up Function URLs, and configures EventBridge
#

set -e

ENV=${1:-$(whoami)}
REGION=${AWS_REGION:-us-east-1}
BUCKET="sportline-data-${ENV}"
UPDATE_LAMBDA="Sportline-Update-${ENV}"
DASHBOARD_LAMBDA="Sportline-Dashboard-${ENV}"
ROLE_NAME="Sportline-LambdaRole-${ENV}"
EVENTBRIDGE_RULE="Sportline-DailyUpdate-${ENV}"

echo "🚀 Deploying Sportline Lambda functions"
echo "   Environment: $ENV"
echo "   Region: $REGION"
echo ""

# Get AWS account ID
ACCOUNT_ID=$(aws sts get-caller-identity --query Account --output text)

# Create IAM role if it doesn't exist
echo "Checking IAM role..."
if ! aws iam get-role --role-name "$ROLE_NAME" 2>/dev/null; then
  echo "Creating IAM role..."

  cat > /tmp/trust-policy.json <<EOF
{
  "Version": "2012-10-17",
  "Statement": [{
    "Effect": "Allow",
    "Principal": {"Service": "lambda.amazonaws.com"},
    "Action": "sts:AssumeRole"
  }]
}
EOF

  aws iam create-role \
    --role-name "$ROLE_NAME" \
    --assume-role-policy-document file:///tmp/trust-policy.json

  # Attach policies
  aws iam attach-role-policy \
    --role-name "$ROLE_NAME" \
    --policy-arn arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole

  # Create inline policy for S3 and Lambda access
  cat > /tmp/inline-policy.json <<EOF
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::${BUCKET}",
        "arn:aws:s3:::${BUCKET}/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["lambda:InvokeFunction"],
      "Resource": "arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:Sportline-*"
    }
  ]
}
EOF

  aws iam put-role-policy \
    --role-name "$ROLE_NAME" \
    --policy-name SportlineAccess \
    --policy-document file:///tmp/inline-policy.json

  echo "✓ IAM role created, waiting 10s for propagation..."
  sleep 10
else
  echo "✓ IAM role exists"
fi

ROLE_ARN="arn:aws:iam::${ACCOUNT_ID}:role/${ROLE_NAME}"

# Build and deploy Update Lambda
echo ""
echo "Building Update Lambda..."
cd lambda/update
npm install --silent
npm run build
npm run package

echo "Deploying Update Lambda..."
if aws lambda get-function --function-name "$UPDATE_LAMBDA" 2>/dev/null; then
  aws lambda update-function-code \
    --function-name "$UPDATE_LAMBDA" \
    --zip-file fileb://lambda.zip \
    --region "$REGION" > /dev/null
  echo "✓ Updated existing function"
else
  aws lambda create-function \
    --function-name "$UPDATE_LAMBDA" \
    --runtime nodejs20.x \
    --role "$ROLE_ARN" \
    --handler index.handler \
    --zip-file fileb://lambda.zip \
    --timeout 300 \
    --memory-size 512 \
    --environment "Variables={BUCKET=${BUCKET}}" \
    --region "$REGION" > /dev/null
  echo "✓ Created new function"
fi

cd ../..

# Build and deploy Dashboard Lambda
echo ""
echo "Building Dashboard Lambda..."
cd lambda/dashboard
npm install --silent
npm run build

# Copy app.js to dist for bundling
cp dist/app.js dist/app.js

npm run package

echo "Deploying Dashboard Lambda..."
if aws lambda get-function --function-name "$DASHBOARD_LAMBDA" 2>/dev/null; then
  aws lambda update-function-code \
    --function-name "$DASHBOARD_LAMBDA" \
    --zip-file fileb://lambda.zip \
    --region "$REGION" > /dev/null
  echo "✓ Updated existing function"
else
  aws lambda create-function \
    --function-name "$DASHBOARD_LAMBDA" \
    --runtime nodejs20.x \
    --role "$ROLE_ARN" \
    --handler index.handler \
    --zip-file fileb://lambda.zip \
    --timeout 30 \
    --memory-size 256 \
    --environment "Variables={BUCKET=${BUCKET},UPDATE_LAMBDA=${UPDATE_LAMBDA}}" \
    --region "$REGION" > /dev/null
  echo "✓ Created new function"
fi

# Create Function URL for Dashboard if it doesn't exist
echo ""
echo "Setting up Function URL for Dashboard..."
if ! aws lambda get-function-url-config --function-name "$DASHBOARD_LAMBDA" 2>/dev/null; then
  DASHBOARD_URL=$(aws lambda create-function-url-config \
    --function-name "$DASHBOARD_LAMBDA" \
    --auth-type NONE \
    --region "$REGION" \
    --query FunctionUrl \
    --output text)

  # Add resource policy to allow public access
  aws lambda add-permission \
    --function-name "$DASHBOARD_LAMBDA" \
    --statement-id FunctionURLAllowPublicAccess \
    --action lambda:InvokeFunctionUrl \
    --principal "*" \
    --function-url-auth-type NONE \
    --region "$REGION" > /dev/null || true

  echo "✓ Function URL created: $DASHBOARD_URL"
else
  DASHBOARD_URL=$(aws lambda get-function-url-config \
    --function-name "$DASHBOARD_LAMBDA" \
    --region "$REGION" \
    --query FunctionUrl \
    --output text)
  echo "✓ Function URL exists: $DASHBOARD_URL"
fi

cd ../..

# Set up EventBridge rule
echo ""
echo "Setting up EventBridge daily trigger..."

if ! aws events describe-rule --name "$EVENTBRIDGE_RULE" 2>/dev/null; then
  aws events put-rule \
    --name "$EVENTBRIDGE_RULE" \
    --schedule-expression "cron(0 13 * * ? *)" \
    --state ENABLED \
    --region "$REGION" > /dev/null
  echo "✓ EventBridge rule created (daily at 8am EST)"
else
  echo "✓ EventBridge rule exists"
fi

# Add Lambda permission for EventBridge
aws lambda add-permission \
  --function-name "$UPDATE_LAMBDA" \
  --statement-id AllowEventBridgeInvoke \
  --action lambda:InvokeFunction \
  --principal events.amazonaws.com \
  --source-arn "arn:aws:events:${REGION}:${ACCOUNT_ID}:rule/${EVENTBRIDGE_RULE}" \
  --region "$REGION" 2>/dev/null || echo "  (permission already exists)"

# Add target to EventBridge rule
aws events put-targets \
  --rule "$EVENTBRIDGE_RULE" \
  --targets "Id=1,Arn=arn:aws:lambda:${REGION}:${ACCOUNT_ID}:function:${UPDATE_LAMBDA}" \
  --region "$REGION" > /dev/null

echo "✓ EventBridge configured"

echo ""
echo "✅ Deployment complete!"
echo ""
echo "Dashboard URL: $DASHBOARD_URL"
echo ""
echo "Next steps:"
echo "  1. Visit the dashboard URL on your mobile device"
echo "  2. Test manual refresh by calling Update Lambda:"
echo "     aws lambda invoke --function-name $UPDATE_LAMBDA /tmp/out.json"
echo "  3. Bookmark or add to home screen on your phone"
