{
  "name": "sportline-infrastructure",
  "version": "1.0.0",
  "description": "CDK infrastructure for Sportline dashboard",
  "scripts": {
    "format": "npx prettier --write \"bin/**/*.ts\" \"lib/**/*.ts\"",
    "lint": "npx eslint bin lib --fix",
    "build": "npm run format && npm run lint && tsc",
    "watch": "tsc -w",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "aws-cdk": "^2.170.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
